* text=auto

# Keep files executed inside Linux containers portable on Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.sql text eol=lf

# PowerShell supports LF; keeping one line-ending policy avoids noisy diffs.
*.ps1 text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
