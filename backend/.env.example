# Local development template. Copy to .env and replace every CHANGE_ME value.
# Never commit the generated .env file.
POSTGRES_USER=smartport
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=maritime
POSTGRES_PORT=5432

MINIO_ROOT_USER=smartportadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MLFLOW_PORT=5000
MLFLOW_ALLOWED_HOSTS=localhost:5000,127.0.0.1:5000,mlflow:5000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_PORT=3001

AIRFLOW_PORT=8080
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=CHANGE_ME_GENERATED_FERNET_KEY
AIRFLOW_API_AUTH_JWT_SECRET=CHANGE_ME_RANDOM_64_BYTE_SECRET
AIRFLOW_PARALLELISM=4

FEATURE_BUILDER_PORT=8090
FEATURE_BUILDER_MEMORY_LIMIT=3g
FEATURE_BUILDER_CPUS=2.0
PREFECT_PORT=4200
PREFECT_POSTGRES_USER=prefect
PREFECT_POSTGRES_PASSWORD=CHANGE_ME_PREFECT_DATABASE_PASSWORD
PREFECT_POSTGRES_DB=prefect
PREFECT_WORK_POOL=smart-port-process
PREFECT_WORKER_MEMORY_LIMIT=3g
PREFECT_WORKER_CPUS=2.0

PLATFORM_API_PORT=8092
MARITIME_PLATFORM_PORT=8088
